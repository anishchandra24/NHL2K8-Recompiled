+// Plays one song at a time through the Windows MCI interface. All MCI calls
+// happen on a single worker thread; the game threads only post commands.
+class MusicPlayer {
+ public:
+  static MusicPlayer& Get() {
+    static MusicPlayer* instance = new MusicPlayer();  // intentionally leaked
+    return *instance;
+  }
+
+  void Play(std::wstring path, float volume) { Post({Cmd::kPlay, std::move(path), volume}); }
+  void Pause() { Post({Cmd::kPause, std::wstring(), 0.0f}); }
+  void Resume() { Post({Cmd::kResume, std::wstring(), 0.0f}); }
+  void Stop() { Post({Cmd::kStop, std::wstring(), 0.0f}); }
+  void SetVolume(float volume) { Post({Cmd::kVolume, std::wstring(), volume}); }
+  bool ConsumeEnded() { return ended_.exchange(false); }
+
+ private:
+  enum class Cmd { kPlay, kPause, kResume, kStop, kVolume };
+  struct Command {
+    Cmd cmd;
+    std::wstring path;
+    float volume;
+  };
+
+  void Post(Command command) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!started_) {
+        started_ = true;
+        std::thread([this] { Run(); }).detach();
+      }
+      queue_.push_back(std::move(command));
+    }
+    cv_.notify_one();
+  }
+
+  static DWORD Send(const std::wstring& command, std::wstring* out = nullptr) {
+    wchar_t buffer[128] = {0};
+    DWORD err = mciSendStringW(command.c_str(), buffer, 127, nullptr);
+    if (out) {
+      *out = buffer;
+    }
+    return err;
+  }
+
+  static void ApplyVolume(float volume) {
+    int v = static_cast<int>(volume * 1000.0f);
+    if (v < 0) v = 0;
+    if (v > 1000) v = 1000;
+    Send(L"setaudio xmp volume to " + std::to_wstring(v));
+  }
+
+  void Run() {
+    bool open = false;
+    bool playing = false;
+    bool paused = false;
+    float volume = 1.0f;
+    auto started_at = std::chrono::steady_clock::now();
+    for (;;) {
+      Command c{};
+      bool have = false;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait_for(lock, std::chrono::milliseconds(200), [this] { return !queue_.empty(); });
+        if (!queue_.empty()) {
+          c = std::move(queue_.front());
+          queue_.pop_front();
+          have = true;
+        }
+      }
+      if (have) {
+        switch (c.cmd) {
+          case Cmd::kPlay: {
+            if (open) {
+              Send(L"stop xmp");
+              Send(L"close xmp");
+              open = false;
+            }
+            volume = c.volume;
+            DWORD err = Send(L"open \"" + c.path + L"\" type mpegvideo alias xmp");
+            if (err) {
+              REXKRNL_ERROR("XMP: MCI open failed (error {})", static_cast<uint32_t>(err));
+              playing = false;
+              break;
+            }
+            open = true;
+            ApplyVolume(volume);
+            err = Send(L"play xmp");
+            if (err) {
+              REXKRNL_ERROR("XMP: MCI play failed (error {})", static_cast<uint32_t>(err));
+              Send(L"close xmp");
+              open = false;
+              playing = false;
+              break;
+            }
+            playing = true;
+            paused = false;
+            started_at = std::chrono::steady_clock::now();
+            break;
+          }
+          case Cmd::kPause:
+            if (open) {
+              Send(L"pause xmp");
+            }
+            paused = true;
+            break;
+          case Cmd::kResume:
+            if (open) {
+              Send(L"resume xmp");
+            }
+            paused = false;
+            break;
+          case Cmd::kStop:
+            if (open) {
+              Send(L"stop xmp");
+              Send(L"close xmp");
+            }
+            open = false;
+            playing = false;
+            paused = false;
+            break;
+          case Cmd::kVolume:
+            volume = c.volume;
+            if (open) {
+              ApplyVolume(volume);
+            }
+            break;
+        }
+      } else if (playing && !paused && open &&
+                 std::chrono::steady_clock::now() - started_at > std::chrono::milliseconds(1500)) {
+        std::wstring mode;
+        Send(L"status xmp mode", &mode);
+        if (mode == L"stopped") {
+          Send(L"close xmp");
+          open = false;
+          playing = false;
+          ended_ = true;
+        }
+      }
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<Command> queue_;
+  bool started_ = false;
+  std::atomic<bool> ended_{false};
+};
+
+// The game gives paths like game:\Z_APO_P.wma; find that file name in the game folder.
+std::filesystem::path ResolveSongPath(const std::u16string& guest_path) {
+  std::string root_str = rex::cvar::GetFlagByName("game_data_root");
+  std::wstring wide(guest_path.begin(), guest_path.end());
+  size_t cut = wide.find_last_of(L"\\/:");
+  std::wstring file = (cut == std::wstring::npos) ? wide : wide.substr(cut + 1);
+  if (file.empty() || root_str.empty()) {
+    return std::filesystem::path();
+  }
+  std::filesystem::path root(root_str);
+  std::error_code ec;
+  std::filesystem::path direct = root / file;
+  if (std::filesystem::exists(direct, ec)) {
+    return direct;
+  }
+  auto it = std::filesystem::recursive_directory_iterator(
+      root, std::filesystem::directory_options::skip_permission_denied, ec);
+  for (; !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    if (it->is_regular_file(ec) && _wcsicmp(it->path().filename().c_str(), file.c_str()) == 0) {
+      return it->path();
+    }
+  }
+  return std::filesystem::path();
+}
