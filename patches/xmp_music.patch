+
+std::filesystem::path ResolveSongPath(const std::u16string&) { return std::filesystem::path(); }
+
+#endif
+
+bool IsShuffle(XmpApp::PlaybackMode mode) { return static_cast<uint32_t>(mode) == 1; }
+
+size_t RandomIndex(size_t count) {
+  static std::mutex rng_mutex;
+  static std::mt19937 rng{std::random_device{}()};
+  std::lock_guard<std::mutex> lock(rng_mutex);
+  return std::uniform_int_distribution<size_t>(0, count - 1)(rng);
+}
+
+size_t NextIndex(size_t current, size_t count, bool shuffle) {
+  if (count <= 1) {
+    return 0;
+  }
+  if (!shuffle) {
+    return (current + 1) % count;
+  }
+  size_t next = current;
+  while (next == current) {
+    next = RandomIndex(count);
+  }
+  return next;
+}
+
+void PlaySong(const XmpApp::Song& song, float volume) {
+  std::filesystem::path path = ResolveSongPath(song.file_path);
+  if (path.empty()) {
+    REXKRNL_ERROR("XMP: cannot find a song file for '{}'", rex::string::to_utf8(song.file_path));
+    return;
+  }
+  REXKRNL_DEBUG("XMP: playing '{}' from {}", rex::string::to_utf8(song.name), path.string());
+  MusicPlayer::Get().Play(path.wstring(), volume);
+}
