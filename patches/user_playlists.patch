+  std::ifstream file(path, std::ios::binary);
+  char magic[4] = {0};
+  if (!file.read(magic, 4) || std::memcmp(magic, "fLaC", 4) != 0) {
+    return;
+  }
+  for (int guard = 0; guard < 128; ++guard) {
+    uint8_t h[4] = {0};
+    if (!file.read(reinterpret_cast<char*>(h), 4)) return;
+    const bool last = (h[0] & 0x80) != 0;
+    const uint8_t type = h[0] & 0x7F;
+    const size_t len = (size_t(h[1]) << 16) | (size_t(h[2]) << 8) | size_t(h[3]);
+    if (type != 4) {
+      if (last) return;
+      file.seekg(static_cast<std::streamoff>(len), std::ios::cur);
+      if (!file) return;
+      continue;
+    }
+    std::vector<uint8_t> block(len);
+    if (!file.read(reinterpret_cast<char*>(block.data()), static_cast<std::streamsize>(len))) {
+      return;
+    }
+    size_t pos = 0;
+    if (pos + 4 > len) return;
+    size_t vendor = ReadLe32(&block[pos]);
+    pos += 4;
+    if (vendor > len - pos) return;
+    pos += vendor;
+    if (pos + 4 > len) return;
+    size_t count = ReadLe32(&block[pos]);
+    pos += 4;
+    for (size_t i = 0; i < count && pos + 4 <= len; ++i) {
+      size_t entry = ReadLe32(&block[pos]);
+      pos += 4;
+      if (entry > len - pos) return;
+      std::string text(reinterpret_cast<const char*>(&block[pos]), entry);
+      pos += entry;
+      size_t eq = text.find('=');
+      if (eq == std::string::npos) continue;
+      std::string key = text.substr(0, eq);
+      for (auto& c : key) {
+        if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+      }
+      std::u16string value = TrimText(rex::string::to_utf16(text.substr(eq + 1)));
+      if (key == "TITLE" && song.name.empty()) {
+        song.name = value;
+      } else if (key == "ARTIST" && song.artist.empty()) {
+        song.artist = value;
+      } else if (key == "ALBUM" && song.album.empty()) {
+        song.album = value;
+      }
+    }
+    return;
+  }
+}
+
+// Finds a child box of the given type inside [begin, end) of an MP4 buffer.
+// On success, body_begin/body_end span the child's contents.
+bool FindMp4Box(const std::vector<uint8_t>& buf, size_t begin, size_t end, const char* type,
+                size_t& body_begin, size_t& body_end) {
+  size_t pos = begin;
+  while (pos + 8 <= end) {
+    uint64_t size = ReadBe32(&buf[pos]);
+    size_t header = 8;
+    if (size == 1) {
+      if (pos + 16 > end) return false;
+      size = (uint64_t(ReadBe32(&buf[pos + 8])) << 32) | ReadBe32(&buf[pos + 12]);
+      header = 16;
+    } else if (size == 0) {
+      size = end - pos;
+    }
+    if (size < header || size > end - pos) return false;
+    if (std::memcmp(&buf[pos + 4], type, 4) == 0) {
+      body_begin = pos + header;
+      body_end = pos + static_cast<size_t>(size);
+      return true;
+    }
+    pos += static_cast<size_t>(size);
+  }
+  return false;
+}
+
+// Reads title, artist and album from an M4A file (moov/udta/meta/ilst).
+void ReadM4aTags(const std::filesystem::path& path, XmpApp::Song& song) {
+  std::ifstream file(path, std::ios::binary);
+  std::vector<uint8_t> moov;
+  for (int guard = 0; guard < 64; ++guard) {
+    uint8_t h[16] = {0};
+    if (!file.read(reinterpret_cast<char*>(h), 8)) return;
+    uint64_t size = ReadBe32(h);
+    uint64_t header = 8;
+    if (size == 1) {
+      if (!file.read(reinterpret_cast<char*>(h + 8), 8)) return;
+      size = (uint64_t(ReadBe32(h + 8)) << 32) | ReadBe32(h + 12);
+      header = 16;
+    }
+    if (size != 0 && size < header) return;
+    if (std::memcmp(h + 4, "moov", 4) == 0) {
+      uint64_t body = size ? size - header : 0;
+      if (!size || body > 64ull * 1024 * 1024) return;
+      moov.resize(static_cast<size_t>(body));
+      if (!file.read(reinterpret_cast<char*>(moov.data()), static_cast<std::streamsize>(body))) {
+        return;
+      }
+      break;
+    }
+    if (!size) return;
+    file.seekg(static_cast<std::streamoff>(size - header), std::ios::cur);
+    if (!file) return;
+  }
+  if (moov.empty()) return;
+  size_t b = 0, e = 0;
+  if (!FindMp4Box(moov, 0, moov.size(), "udta", b, e)) return;
+  if (!FindMp4Box(moov, b, e, "meta", b, e)) return;
+  // "meta" normally starts with 4 bytes of version/flags before its children.
+  if (b + 12 <= e && std::memcmp(&moov[b + 4], "hdlr", 4) != 0) b += 4;
+  if (!FindMp4Box(moov, b, e, "ilst", b, e)) return;
+  auto read_item = [&](const char* type, std::u16string& out) {
+    size_t ib = 0, ie = 0, db = 0, de = 0;
+    if (!out.empty() || !FindMp4Box(moov, b, e, type, ib, ie)) return;
+    if (!FindMp4Box(moov, ib, ie, "data", db, de) || db + 8 > de) return;
+    if (ReadBe32(&moov[db]) != 1) return;  // 1 = UTF-8 text
+    out = TrimText(rex::string::to_utf16(
+        std::string_view(reinterpret_cast<const char*>(&moov[db + 8]), de - db - 8)));
+  };
+  read_item("\xA9nam", song.name);
+  read_item("\xA9" "ART", song.artist);
+  read_item("\xA9" "alb", song.album);
+}
+
+// Fills in a song's details from its tags; without tags, the file name is the title.
+void FillSongInfo(const std::filesystem::path& path, XmpApp::Song& song) {
+  auto ext = path.extension().u16string();
+  for (auto& c : ext) {
+    if (c >= u'A' && c <= u'Z') c = static_cast<char16_t>(c - u'A' + u'a');
+  }
+  if (ext == u".mp3") {
+    ReadId3Tags(path, song);
+  } else if (ext == u".flac") {
+    ReadFlacTags(path, song);
+  } else if (ext == u".m4a") {
+    ReadM4aTags(path, song);
+  }
+  if (song.name.empty()) {
+    song.name = path.stem().u16string();
+  }
+}
