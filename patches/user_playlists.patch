+// Reads title, artist and album from an MP3's ID3v2 tag, if it has one.
+void ReadId3Tags(const std::filesystem::path& path, XmpApp::Song& song) {
+  std::ifstream file(path, std::ios::binary);
+  uint8_t h[10] = {0};
+  if (!file.read(reinterpret_cast<char*>(h), 10) || h[0] != 'I' || h[1] != 'D' || h[2] != '3') {
+    return;
+  }
+  const uint8_t version = h[3];
+  if (version < 2 || version > 4 || (h[5] & 0x80)) {
+    return;  // unknown version, or unsynchronised (rare): fall back to the file name
+  }
+  size_t size = (size_t(h[6] & 0x7F) << 21) | (size_t(h[7] & 0x7F) << 14) |
+                (size_t(h[8] & 0x7F) << 7) | size_t(h[9] & 0x7F);
+  size = std::min<size_t>(size, 4 * 1024 * 1024);
+  std::vector<uint8_t> tag(size);
+  file.read(reinterpret_cast<char*>(tag.data()), static_cast<std::streamsize>(size));
+  size = static_cast<size_t>(file.gcount());
+  size_t pos = 0;
+  if (version >= 3 && (h[5] & 0x40) && size >= 4) {  // extended header
+    size_t ext = version == 4 ? ((size_t(tag[0] & 0x7F) << 21) | (size_t(tag[1] & 0x7F) << 14) |
+                                 (size_t(tag[2] & 0x7F) << 7) | size_t(tag[3] & 0x7F))
+                              : (((size_t(tag[0]) << 24) | (size_t(tag[1]) << 16) |
+                                  (size_t(tag[2]) << 8) | size_t(tag[3])) + 4);
+    pos = ext;
+  }
+  const size_t header = version == 2 ? 6 : 10;
+  while (pos + header <= size) {
+    const uint8_t* f = tag.data() + pos;
+    if (!f[0]) break;  // padding
+    size_t frame_size;
+    std::string id;
+    if (version == 2) {
+      id.assign(reinterpret_cast<const char*>(f), 3);
+      frame_size = (size_t(f[3]) << 16) | (size_t(f[4]) << 8) | size_t(f[5]);
+    } else {
+      id.assign(reinterpret_cast<const char*>(f), 4);
+      frame_size = version == 4 ? ((size_t(f[4] & 0x7F) << 21) | (size_t(f[5] & 0x7F) << 14) |
+                                   (size_t(f[6] & 0x7F) << 7) | size_t(f[7] & 0x7F))
+                                : ((size_t(f[4]) << 24) | (size_t(f[5]) << 16) |
+                                   (size_t(f[6]) << 8) | size_t(f[7]));
+    }
+    pos += header;
+    if (frame_size > size - pos) break;
+    const uint8_t* data = tag.data() + pos;
+    if (id == "TIT2" || id == "TT2") {
+      song.name = DecodeId3Text(data, frame_size);
+    } else if (id == "TPE1" || id == "TP1") {
+      song.artist = DecodeId3Text(data, frame_size);
+    } else if (id == "TALB" || id == "TAL") {
+      song.album = DecodeId3Text(data, frame_size);
+    }
+    pos += frame_size;
+  }
+}
+
+uint32_t ReadBe32(const uint8_t* p) {
+  return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+uint32_t ReadLe32(const uint8_t* p) {
+  return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
