+// Receives the media engine's events (on its own threads) and keeps the ones we need.
+class EngineEvents final : public IMFMediaEngineNotify {
+ public:
+  STDMETHODIMP QueryInterface(REFIID riid, void** ppv) override {
+    if (!ppv) return E_POINTER;
+    if (IsEqualGUID(riid, kIidUnknown) || IsEqualGUID(riid, kIidMediaEngineNotify)) {
+      *ppv = static_cast<IMFMediaEngineNotify*>(this);
+      AddRef();
+      return S_OK;
+    }
+    *ppv = nullptr;
+    return E_NOINTERFACE;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++refs_; }
+  STDMETHODIMP_(ULONG) Release() override {
+    ULONG r = --refs_;
+    if (!r) delete this;
+    return r;
+  }
+  STDMETHODIMP EventNotify(DWORD event, DWORD_PTR param1, DWORD) override {
+    switch (event) {
+      case MF_MEDIA_ENGINE_EVENT_PLAYING:
+        playing = true;
+        break;
+      case MF_MEDIA_ENGINE_EVENT_ENDED:
+        ended = true;
+        break;
+      case MF_MEDIA_ENGINE_EVENT_ERROR:
+        // param1 is the error code; 1 (aborted) only means we switched songs.
+        if (param1 != 1) error = true;
+        break;
+      default:
+        break;
+    }
+    return S_OK;
+  }
+  void Reset() {
+    playing = false;
+    ended = false;
+    error = false;
+  }
+  std::atomic<bool> playing{false};
+  std::atomic<bool> ended{false};
+  std::atomic<bool> error{false};
+
+ private:
+  std::atomic<ULONG> refs_{1};
+};
