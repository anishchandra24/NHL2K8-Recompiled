+// The message the game's media library uses to list the user's playlists.
+constexpr uint32_t kXmpUserPlaylistEnumMessage = 0x00070026;
+// XMP_USER_PLAYLIST_INFO: id[572], big-endian char16 title[40], reserved[168].
+constexpr size_t kUserPlaylistInfoSize = 0x334;
+constexpr size_t kUserPlaylistIdSize = 572;
+constexpr size_t kUserPlaylistTitleChars = 40;
+constexpr size_t kUserPlaylistIdNameChars = 260;
+constexpr size_t kMaxUserPlaylists = 64;
+
+bool IsSongFile(const std::filesystem::path& path) {
+  auto ext = path.extension().u16string();
+  for (auto& c : ext) {
+    if (c >= u'A' && c <= u'Z') c = static_cast<char16_t>(c - u'A' + u'a');
+  }
+  return ext == u".mp3" || ext == u".wma" || ext == u".wav" || ext == u".m4a" || ext == u".flac";
+}
+
+void StoreBe16(uint8_t* dst, uint16_t value) {
+  dst[0] = static_cast<uint8_t>(value >> 8);
+  dst[1] = static_cast<uint8_t>(value & 0xFF);
+}
+
+void StoreBe32(uint8_t* dst, uint32_t value) {
+  dst[0] = static_cast<uint8_t>(value >> 24);
+  dst[1] = static_cast<uint8_t>((value >> 16) & 0xFF);
+  dst[2] = static_cast<uint8_t>((value >> 8) & 0xFF);
+  dst[3] = static_cast<uint8_t>(value & 0xFF);
+}
+
+// Lists one entry per folder in <user data>\playlists. The id holds "RXPL", the
+// entry index and the folder name, so later calls can tell which one was picked.
+class UserPlaylistEnumerator : public XEnumerator {
+ public:
+  UserPlaylistEnumerator(KernelState* kernel_state, size_t items_per_enumerate, size_t stride)
+      : XEnumerator(kernel_state, items_per_enumerate, stride), stride_(stride) {}
+
+  size_t count() const { return entries_.size() / stride_; }
+
+  void Add(const std::u16string& name) {
+    size_t offset = entries_.size();
+    entries_.resize(offset + stride_, 0);
+    uint8_t* entry = entries_.data() + offset;
+    std::memcpy(entry, "RXPL", 4);
+    StoreBe32(entry + 4, static_cast<uint32_t>(offset / stride_));
+    size_t id_chars = std::min(name.size(), kUserPlaylistIdNameChars);
+    StoreBe16(entry + 8, static_cast<uint16_t>(id_chars));
+    for (size_t i = 0; i < id_chars; ++i) {
+      StoreBe16(entry + 12 + i * 2, static_cast<uint16_t>(name[i]));
+    }
+    size_t title_chars = std::min(name.size(), kUserPlaylistTitleChars - 1);
+    for (size_t i = 0; i < title_chars; ++i) {
+      StoreBe16(entry + kUserPlaylistIdSize + i * 2, static_cast<uint16_t>(name[i]));
+    }
+  }
+
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data,
+                      uint32_t* written_count) override {
+    size_t per_call = items_per_enumerate() ? items_per_enumerate() : count();
+    size_t n = std::min(count() - current_, per_call);
+    REXKRNL_INFO("XMP: user playlist enumerate at {:08X}: giving {} of {} (stride {})", buffer_ptr,
+                 n, count(), stride_);
+    if (!n) {
+      return X_ERROR_NO_MORE_FILES;
+    }
+    std::memcpy(buffer_data, entries_.data() + current_ * stride_, n * stride_);
+    current_ += n;
+    if (written_count) {
+      *written_count = static_cast<uint32_t>(n);
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  size_t stride_;
+  size_t current_ = 0;
+  std::vector<uint8_t> entries_;
+};
+
+}  // namespace
+
+u32 XamCreateEnumeratorHandle_entry(u32 user_index, u32 app_id, u32 open_message,
+                                    u32 close_message, u32 extra_size, u32 item_count, u32 flags,
+                                    mapped_u32 out_handle) {
+  REXKRNL_INFO(
+      "XamCreateEnumeratorHandle(user={:08X}, app={:08X}, open={:08X}, close={:08X}, "
+      "extra={:X}, items={}, flags={:08X})",
+      user_index, app_id, open_message, close_message, extra_size, item_count, flags);
+  if (open_message != kXmpUserPlaylistEnumMessage) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  size_t stride = static_cast<size_t>(
+      std::clamp<int32_t>(REXCVAR_GET(user_playlist_item_size),
+                          static_cast<int32_t>(kUserPlaylistInfoSize), 0x400));
+  auto e = make_object<UserPlaylistEnumerator>(REX_KERNEL_STATE(), item_count, stride);
+  auto result =
+      e->Initialize(user_index, app_id, open_message, close_message, flags, extra_size, nullptr);
+  if (XFAILED(result)) {
+    return result;
+  }
+
+  std::error_code ec;
+  auto user_root = REX_KERNEL_STATE()->emulator()->user_data_root();
+  auto dir = (user_root.empty() ? std::filesystem::current_path(ec) : user_root) / "playlists";
+  std::filesystem::create_directories(dir, ec);
+  std::vector<std::filesystem::path> folders;
+  for (std::filesystem::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+    std::error_code ec2;
+    if (it->is_directory(ec2)) {
+      folders.push_back(it->path());
+    }
+  }
+  std::sort(folders.begin(), folders.end());
+  if (folders.size() > kMaxUserPlaylists) {
+    folders.resize(kMaxUserPlaylists);
+  }
+  for (const auto& folder : folders) {
+    size_t songs = 0;
+    std::error_code ec3;
+    for (std::filesystem::directory_iterator it(folder, ec3), end; !ec3 && it != end;
+         it.increment(ec3)) {
+      std::error_code ec4;
+      if (it->is_regular_file(ec4) && IsSongFile(it->path())) {
+        ++songs;
+      }
+    }
+    e->Add(folder.filename().u16string());
+    REXKRNL_INFO("XMP: user playlist #{} '{}' ({} songs)", e->count() - 1,
+                 rex::string::to_utf8(folder.filename().u16string()), songs);
+  }
+  REXKRNL_INFO("XMP: {} user playlists found in {}", e->count(), rex::string::to_utf8(dir.u16string()));
+
+  if (out_handle.guest_address()) {
+    *out_handle = e->handle();
+  }
+  return X_ERROR_SUCCESS;
