+std::u16string TrimText(std::u16string text) {
+  while (!text.empty() && (text.back() == 0 || text.back() == u' ')) text.pop_back();
+  size_t start = 0;
+  while (start < text.size() && text[start] == u' ') ++start;
+  return text.substr(start);
+}
+
+// One ID3v2 text frame: an encoding byte, then the text.
+std::u16string DecodeId3Text(const uint8_t* p, size_t n) {
+  if (!n) return std::u16string();
+  uint8_t encoding = p[0];
+  ++p;
+  --n;
+  std::u16string out;
+  if (encoding == 0) {  // Latin-1
+    for (size_t i = 0; i < n && p[i]; ++i) out.push_back(static_cast<char16_t>(p[i]));
+  } else if (encoding == 3) {  // UTF-8
+    size_t len = 0;
+    while (len < n && p[len]) ++len;
+    out = rex::string::to_utf16(std::string_view(reinterpret_cast<const char*>(p), len));
+  } else {  // UTF-16 with a byte order mark (1) or big-endian (2)
+    bool big_endian = encoding == 2;
+    if (encoding == 1 && n >= 2) {
+      if (p[0] == 0xFF && p[1] == 0xFE) {
+        big_endian = false;
+        p += 2;
+        n -= 2;
+      } else if (p[0] == 0xFE && p[1] == 0xFF) {
+        big_endian = true;
+        p += 2;
+        n -= 2;
+      }
+    }
+    for (size_t i = 0; i + 1 < n; i += 2) {
+      char16_t c = big_endian ? static_cast<char16_t>((p[i] << 8) | p[i + 1])
+                              : static_cast<char16_t>((p[i + 1] << 8) | p[i]);
+      if (!c) break;
+      out.push_back(c);
+    }
+  }
+  return TrimText(out);
+}
