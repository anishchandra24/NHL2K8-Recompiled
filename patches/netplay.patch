+u32 NetDll_XNetCreateKey_entry(u32 caller, u32 xnkid, u32 xnkey) {
+  static std::mt19937 rng(std::random_device{}());
+  auto mem = REX_KERNEL_MEMORY();
+  if (xnkid) {
+    uint8_t* p = mem->TranslateVirtual<uint8_t*>(xnkid);
+    for (int i = 0; i < 8; ++i) p[i] = uint8_t(rng());
+    p[0] = uint8_t(0x80 | (p[0] & 0x0F));
+  }
+  if (xnkey) {
+    uint8_t* p = mem->TranslateVirtual<uint8_t*>(xnkey);
+    for (int i = 0; i < 16; ++i) p[i] = uint8_t(rng());
+  }
+  return 0;
+}
