+REXCVAR_DEFINE_BOOL(online_play, true, "Network",
+                    "Act as signed in to Xbox Live so the game's online modes can find and join "
+                    "games on your network (or a virtual LAN such as ZeroTier)");
+
+// ===== netplay (NHL 2K8 Recompiled patch): Xbox Live sessions found over the local network =====
+// Hosts announce their game session on the network every second; searching players collect
+// those announcements. Works on a home network, or over the internet through a virtual LAN
+// app (ZeroTier, Radmin VPN, Tailscale) with net_ip set to that app's address.
+REXCVAR_DEFINE_STRING(net_ip, "", "Network",
+                      "Your IPv4 address for online play (empty = automatic). Use your ZeroTier / "
+                      "Radmin VPN / Tailscale address to play over the internet, or 127.0.0.x to "
+                      "run two copies on one PC");
+REXCVAR_DEFINE_STRING(net_peers, "", "Network",
+                      "Extra addresses to announce games to, comma separated (for networks where "
+                      "broadcast does not reach the other player)");
+REXCVAR_DEFINE_INT32(net_lobby_port, 36020, "Network", "UDP port used to find games");
+REXCVAR_DEFINE_STRING(net_gamertag, "", "Network", "Gamertag shown to other players (empty = User)");
