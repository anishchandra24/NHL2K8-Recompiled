+// netplay (NHL 2K8 Recompiled patch): fill an XSESSION_SEARCHRESULT_HEADER with games found on the network.
+static void WriteSearchResults(memory::Memory* mem, uint32_t num_results, uint16_t num_ctx,
+                               uint32_t ctx_ptr, uint32_t size_value, uint32_t results_ptr) {
+  std::vector<std::pair<uint32_t, uint32_t>> wanted;
+  if (ctx_ptr) {
+    auto c = mem->TranslateVirtual<uint8_t*>(ctx_ptr);
+    for (uint16_t i = 0; i < num_ctx; ++i) {
+      wanted.emplace_back(memory::load_and_swap<uint32_t>(c + i * 8),
+                          memory::load_and_swap<uint32_t>(c + i * 8 + 4));
+    }
+  }
+  auto found = netplay::FindSessions(wanted);
+  // The size is sometimes passed as a pointer to the size.
+  uint32_t size = size_value;
+  if (size_value >= 0x01000000) {
+    size = memory::load_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(size_value));
+  }
+  REXKRNL_INFO("netplay: game search ({} settings, up to {}) found {} game(s), buffer {:X}/{:X}",
+               num_ctx, num_results, found.size(), size_value, size);
+  if (!results_ptr || size < 8) {
+    return;
+  }
+  constexpr uint32_t kResultSize = 0x5C;
+  size_t n = std::min<size_t>(found.size(), num_results);
+  auto needed = [&](size_t count) {
+    size_t total = 8 + count * kResultSize;
+    for (size_t i = 0; i < count; ++i) total += found[i].contexts.size() * 8;
+    return total;
+  };
+  while (n > 0 && needed(n) > size) --n;
+  auto out = mem->TranslateVirtual<uint8_t*>(results_ptr);
+  memory::store_and_swap<uint32_t>(out + 0, uint32_t(n));
+  memory::store_and_swap<uint32_t>(out + 4, n ? results_ptr + 8 : 0);
+  uint32_t ctx_at = results_ptr + 8 + uint32_t(n) * kResultSize;
+  for (size_t i = 0; i < n; ++i) {
+    const auto& s = found[i];
+    uint8_t* r = out + 8 + i * kResultSize;
+    std::memcpy(r, s.xnkid, 8);
+    std::memcpy(r + 8, s.xnaddr, 36);
+    std::memcpy(r + 44, s.xnkey, 16);
+    memory::store_and_swap<uint32_t>(r + 60, s.open_pub);
+    memory::store_and_swap<uint32_t>(r + 64, s.open_priv);
+    memory::store_and_swap<uint32_t>(r + 68, s.filled_pub);
+    memory::store_and_swap<uint32_t>(r + 72, s.filled_priv);
+    memory::store_and_swap<uint32_t>(r + 76, 0);  // properties
+    memory::store_and_swap<uint32_t>(r + 80, uint32_t(s.contexts.size()));
+    memory::store_and_swap<uint32_t>(r + 84, 0);
+    memory::store_and_swap<uint32_t>(r + 88, s.contexts.empty() ? 0 : ctx_at);
+    for (auto& c : s.contexts) {
+      uint8_t* p = mem->TranslateVirtual<uint8_t*>(ctx_at);
+      memory::store_and_swap<uint32_t>(p, c.first);
+      memory::store_and_swap<uint32_t>(p + 4, c.second);
+      ctx_at += 8;
+    }
+  }
+}
