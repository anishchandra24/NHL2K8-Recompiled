+// Measures the connection to other players' games. Everything found on the network is
+// reported as reachable with a good connection, plus the host's QoS data.
+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 count, u32 xnaddr_ptrs, u32 xnkid_ptrs,
+                               u32 xnkey_ptrs, u32 ina_count, u32 inas, u32 service_ids,
+                               u32 probes, u32 bits_per_sec, u32 flags, u32 event_handle,
+                               mapped_u32 pqos) {
+  auto mem = REX_KERNEL_MEMORY();
+  std::vector<std::vector<uint8_t>> datas(count);
+  uint32_t data_total = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (xnkid_ptrs) {
+      uint32_t kid = memory::load_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(xnkid_ptrs) +
+                                                     i * 4);
+      if (kid) datas[i] = netplay::GetQosData(mem->TranslateVirtual<uint8_t*>(kid));
+    }
+    data_total += uint32_t(datas[i].size());
+  }
+  uint32_t header = 8 + std::max<uint32_t>(count, 1) * 24;
+  uint32_t guest = mem->SystemHeapAlloc(header + data_total);
+  uint8_t* q = mem->TranslateVirtual<uint8_t*>(guest);
+  std::memset(q, 0, header + data_total);
+  memory::store_and_swap<uint32_t>(q + 0, count);
+  memory::store_and_swap<uint32_t>(q + 4, 0);
+  uint32_t data_at = guest + header;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint8_t* e = q + 8 + i * 24;
+    e[0] = uint8_t(0x01 | 0x02 | (datas[i].empty() ? 0 : 0x08));  // complete, contacted, data
+    memory::store_and_swap<uint16_t>(e + 2, 4);                   // probes sent
+    memory::store_and_swap<uint16_t>(e + 4, 4);                   // probes received
+    memory::store_and_swap<uint16_t>(e + 6, uint16_t(datas[i].size()));
+    memory::store_and_swap<uint32_t>(e + 8, datas[i].empty() ? 0 : data_at);
+    memory::store_and_swap<uint16_t>(e + 12, 30);                 // RTT min (ms)
+    memory::store_and_swap<uint16_t>(e + 14, 40);                 // RTT median (ms)
+    memory::store_and_swap<uint32_t>(e + 16, 8000000);            // up bits/s
+    memory::store_and_swap<uint32_t>(e + 20, 8000000);            // down bits/s
+    if (!datas[i].empty()) {
+      std::memcpy(mem->TranslateVirtual<uint8_t*>(data_at), datas[i].data(), datas[i].size());
+      data_at += uint32_t(datas[i].size());
+    }
+  }
+  if (pqos) {
+    *pqos = guest;
+  }
+  if (event_handle) {
+    auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle);
+    if (ev) ev->Set(0, false);
+  }
+  REXKRNL_INFO("netplay: connection check for {} game(s)", count);
+  return 0;
+}
