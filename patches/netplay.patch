+namespace rex {
+namespace kernel {
+namespace xam {
+namespace netplay {
+
+bool OnlineEnabled() { return REXCVAR_GET(online_play); }
+
+#if REX_PLATFORM_WIN32
+using socklen_type = int;
+using sock_t = SOCKET;
+static const sock_t kBadSock = INVALID_SOCKET;
+static void CloseSock(sock_t s) { closesocket(s); }
+#else
+using socklen_type = socklen_t;
+using sock_t = int;
+static const sock_t kBadSock = -1;
+static void CloseSock(sock_t s) { close(s); }
+#endif
+
+static uint64_t NowMs() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+
+static void Put32(std::vector<uint8_t>& v, uint32_t x) {
+  for (int i = 0; i < 4; ++i) v.push_back(static_cast<uint8_t>(x >> (i * 8)));
+}
+static uint32_t Get32(const uint8_t* p) {
+  return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+static void StoreBe32(uint8_t* p, uint32_t x) {
+  p[0] = uint8_t(x >> 24); p[1] = uint8_t(x >> 16); p[2] = uint8_t(x >> 8); p[3] = uint8_t(x);
+}
+static void StoreBe16(uint8_t* p, uint16_t x) {
+  p[0] = uint8_t(x >> 8); p[1] = uint8_t(x);
+}
+
+// "a.b.c.d" -> host-order value, 0 if invalid.
+static uint32_t ParseIp(const std::string& s) {
+  uint32_t parts[4] = {0, 0, 0, 0};
+  int n = 0;
+  uint32_t cur = 0;
+  bool digit = false;
+  for (char c : s) {
+    if (c >= '0' && c <= '9') {
+      cur = cur * 10 + uint32_t(c - '0');
+      digit = true;
+      if (cur > 255) return 0;
+    } else if (c == '.' && digit && n < 3) {
+      parts[n++] = cur;
+      cur = 0;
+      digit = false;
+    } else if (c == ' ') {
+      continue;
+    } else {
+      return 0;
+    }
+  }
+  if (!digit || n != 3) return 0;
+  parts[3] = cur;
+  return (parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3];
+}
+
+std::string IpToString(uint32_t ip) {
+  return fmt::format("{}.{}.{}.{}", ip >> 24, (ip >> 16) & 0xFF, (ip >> 8) & 0xFF, ip & 0xFF);
+}
+
+static void EnsureWinsock() {
+#if REX_PLATFORM_WIN32
+  static std::once_flag once;
+  std::call_once(once, [] {
+    WSADATA data;
+    WSAStartup(MAKEWORD(2, 2), &data);
+  });
+#endif
+}
+
+bool HasFixedIp() { return ParseIp(REXCVAR_GET(net_ip)) != 0; }
+
+// This PC's address for online play, host order.
+uint32_t LocalIp() {
+  static std::once_flag once;
+  static uint32_t ip = 0;
+  std::call_once(once, [] {
+    ip = ParseIp(REXCVAR_GET(net_ip));
+    if (!ip) {
+      // Ask the OS which address it would use to reach the internet (nothing is sent).
+      EnsureWinsock();
+      sock_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+      if (s != kBadSock) {
+        sockaddr_in to = {};
+        to.sin_family = AF_INET;
+        to.sin_port = htons(53);
+        to.sin_addr.s_addr = htonl(0x08080808);
+        if (connect(s, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+          sockaddr_in me = {};
+          socklen_type len = sizeof(me);
+          if (getsockname(s, reinterpret_cast<sockaddr*>(&me), &len) == 0) {
+            ip = ntohl(me.sin_addr.s_addr);
+          }
+        }
+        CloseSock(s);
+      }
+    }
+    if (!ip) ip = 0x7F000001;
+    REXKRNL_INFO("netplay: this PC's address for online play is {}", IpToString(ip));
+  });
+  return ip;
+}
+
+// The XNADDR of a machine is made only from its IP, so every PC computes the same one.
+void MakeXnAddr(uint32_t ip, uint8_t* out) {
+  std::memset(out, 0, 36);
+  StoreBe32(out + 0, ip);   // ina
+  StoreBe32(out + 4, ip);   // inaOnline
+  StoreBe16(out + 8, 3074); // wPortOnline
+  out[10] = 0x00; out[11] = 0x22; out[12] = 0x48;  // abEnet
+  out[13] = uint8_t(ip >> 16); out[14] = uint8_t(ip >> 8); out[15] = uint8_t(ip);
+  StoreBe32(out + 16, ip);  // abOnline
+}
+
+uint32_t XnAddrIp(const uint8_t* xnaddr) {
+  return (uint32_t(xnaddr[0]) << 24) | (uint32_t(xnaddr[1]) << 16) | (uint32_t(xnaddr[2]) << 8) |
+         uint32_t(xnaddr[3]);
+}
+
+// A player ID that differs between PCs (online games tell players apart by it) but stays the
+// same on one PC: made from the computer's name, plus net_ip for two copies on one PC.
+uint64_t OnlineXuid(uint64_t profile_xuid) {
+  static std::once_flag once;
+  static uint32_t id = 0;
+  std::call_once(once, [] {
+    EnsureWinsock();
+    char host[256] = {};
+    if (gethostname(host, sizeof(host) - 1) != 0) host[0] = 0;
+    std::string key = std::string(host) + "|" + std::string(REXCVAR_GET(net_ip));
+    uint32_t h = 2166136261u;
+    for (unsigned char c : key) h = (h ^ c) * 16777619u;
+    id = h ? h : 1;
+  });
+  return (profile_xuid & 0xFFFFFFFF00000000ull) | id;
+}
+
+std::string Gamertag(const std::string& profile_name) {
+  std::string tag = REXCVAR_GET(net_gamertag);
+  if (tag.empty()) return profile_name;
+  if (tag.size() > 15) tag.resize(15);
+  return tag;
+}
