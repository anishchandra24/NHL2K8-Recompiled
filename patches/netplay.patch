+static std::mutex g_mutex;
+static std::map<uint32_t, uint32_t> g_contexts;  // XUserSetContext values of player 1
+static bool g_hosting = false;
+static bool g_started = false;
+static Session g_host;
+static uint32_t g_slots_pub = 0, g_slots_priv = 0;
+static std::map<uint64_t, Session> g_seen;
+static std::map<uint64_t, std::vector<uint8_t>> g_qos_data;  // XNetQosListen data by XNKID
+static std::map<uint32_t, uint64_t> g_peers_seen;  // other PCs heard on the network, by IP
+static std::once_flag g_thread_once;
+static sock_t g_sock = kBadSock;
+
+static uint64_t KidKey(const uint8_t* kid) {
+  uint64_t k = 0;
+  for (int i = 0; i < 8; ++i) k = (k << 8) | kid[i];
+  return k;
+}
+
+static void RandomBytes(uint8_t* p, size_t n) {
+  static std::mt19937_64 rng(std::random_device{}() ^ NowMs());
+  for (size_t i = 0; i < n; ++i) p[i] = static_cast<uint8_t>(rng());
+}
+
+static const char kMagic[8] = {'R', 'E', 'X', 'L', 'O', 'B', 'B', '1'};
+// "Is anyone hosting?" (flag 1) and "I'm here" (flag 0) messages. They let PCs learn each
+// other's addresses, so game announcements can also go straight to them, which is more
+// reliable than broadcast on Wi-Fi.
+static const char kQueryMagic[8] = {'R', 'E', 'X', 'L', 'O', 'B', 'Q', '1'};
+
+static std::vector<uint8_t> BuildAnnouncement() {
+  std::vector<uint8_t> v(kMagic, kMagic + 8);
+  Put32(v, REX_KERNEL_STATE()->title_id());
+  v.insert(v.end(), g_host.xnkid, g_host.xnkid + 8);
+  v.insert(v.end(), g_host.xnaddr, g_host.xnaddr + 36);
+  v.insert(v.end(), g_host.xnkey, g_host.xnkey + 16);
+  uint32_t open_pub = g_slots_pub > g_host.filled_pub ? g_slots_pub - g_host.filled_pub : 0;
+  uint32_t open_priv = g_slots_priv > g_host.filled_priv ? g_slots_priv - g_host.filled_priv : 0;
+  Put32(v, open_pub);
+  Put32(v, open_priv);
+  Put32(v, g_host.filled_pub);
+  Put32(v, g_host.filled_priv);
+  uint32_t nctx = static_cast<uint32_t>(std::min<size_t>(g_host.contexts.size(), 32));
+  Put32(v, nctx);
+  for (uint32_t i = 0; i < nctx; ++i) {
+    Put32(v, g_host.contexts[i].first);
+    Put32(v, g_host.contexts[i].second);
+  }
+  auto it = g_qos_data.find(KidKey(g_host.xnkid));
+  uint32_t qlen = it == g_qos_data.end() ? 0 : uint32_t(std::min<size_t>(it->second.size(), 512));
+  Put32(v, qlen);
+  if (qlen) v.insert(v.end(), it->second.begin(), it->second.begin() + qlen);
+  return v;
+}
+
+static void ParseAnnouncement(const uint8_t* p, size_t len, uint32_t from_ip) {
+  if (len < 8 + 4 + 8 + 36 + 16 + 20 || std::memcmp(p, kMagic, 8) != 0) return;
+  size_t o = 8;
+  if (Get32(p + o) != REX_KERNEL_STATE()->title_id()) return;
+  o += 4;
+  Session s;
+  std::memcpy(s.xnkid, p + o, 8); o += 8;
+  std::memcpy(s.xnaddr, p + o, 36); o += 36;
+  std::memcpy(s.xnkey, p + o, 16); o += 16;
+  s.open_pub = Get32(p + o); s.open_priv = Get32(p + o + 4);
+  s.filled_pub = Get32(p + o + 8); s.filled_priv = Get32(p + o + 12);
+  uint32_t nctx = Get32(p + o + 16);
+  o += 20;
+  if (nctx > 32 || o + nctx * 8 + 4 > len) return;
+  for (uint32_t i = 0; i < nctx; ++i, o += 8) s.contexts.emplace_back(Get32(p + o), Get32(p + o + 4));
+  uint32_t qlen = Get32(p + o);
+  o += 4;
+  if (qlen > 512 || o + qlen > len) return;
+  s.qos.assign(p + o, p + o + qlen);
+  s.from_ip = from_ip;
+  s.seen_ms = NowMs();
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_hosting && KidKey(s.xnkid) == KidKey(g_host.xnkid)) return;
+  bool is_new = g_seen.find(KidKey(s.xnkid)) == g_seen.end();
+  g_seen[KidKey(s.xnkid)] = s;
+  if (is_new) {
+    REXKRNL_INFO("netplay: found a game hosted at {} (announced from {})",
+                 IpToString(XnAddrIp(s.xnaddr)), IpToString(from_ip));
+  }
+}
+
+static void SendTo(const std::vector<uint8_t>& pkt, uint32_t ip, uint16_t port) {
+  sockaddr_in to = {};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(port);
+  to.sin_addr.s_addr = htonl(ip);
+  sendto(g_sock, reinterpret_cast<const char*>(pkt.data()), int(pkt.size()), 0,
+         reinterpret_cast<sockaddr*>(&to), sizeof(to));
+}
+
+static std::vector<uint32_t> ConfiguredPeers() {
+  static std::once_flag once;
+  static std::vector<uint32_t> peers;
+  std::call_once(once, [] {
+    std::string list = REXCVAR_GET(net_peers);
+    size_t start = 0;
+    while (start <= list.size()) {
+      size_t comma = list.find(',', start);
+      if (comma == std::string::npos) comma = list.size();
+      uint32_t ip = ParseIp(list.substr(start, comma - start));
+      if (ip && ip != LocalIp()) peers.push_back(ip);
+      start = comma + 1;
+    }
+  });
+  return peers;
+}
+
+// Every address a lobby message goes to: broadcast, this network's broadcast, net_peers, and
+// (optionally) every PC heard from in the last minute.
+static std::vector<uint32_t> Targets(bool learned) {
+  uint32_t me = LocalIp();
+  std::vector<uint32_t> t = {0xFFFFFFFF, (me & 0xFFFFFF00) | 0xFF};
+  for (uint32_t ip : ConfiguredPeers()) t.push_back(ip);
+  if (learned) {
+    uint64_t now = NowMs();
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (auto& kv : g_peers_seen) {
+      if (now - kv.second < 60000 &&
+          std::find(t.begin(), t.end(), kv.first) == t.end()) {
+        t.push_back(kv.first);
+      }
+    }
+  }
+  return t;
+}
+
+static std::vector<uint8_t> BuildQuery(uint32_t flag) {
+  std::vector<uint8_t> v(kQueryMagic, kQueryMagic + 8);
+  Put32(v, REX_KERNEL_STATE()->title_id());
+  Put32(v, flag);
+  return v;
+}
+
+static void HandlePacket(const uint8_t* p, size_t len, uint32_t from_ip, uint16_t port) {
+  if (from_ip == LocalIp() || len < 16) return;
+  if (Get32(p + 8) != REX_KERNEL_STATE()->title_id()) return;
+  bool query = std::memcmp(p, kQueryMagic, 8) == 0;
+  if (!query && std::memcmp(p, kMagic, 8) != 0) return;
+  bool new_peer;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    new_peer = g_peers_seen.find(from_ip) == g_peers_seen.end();
+    g_peers_seen[from_ip] = NowMs();
+  }
+  if (new_peer) REXKRNL_INFO("netplay: another PC is on the network at {}", IpToString(from_ip));
+  if (!query) {
+    ParseAnnouncement(p, len, from_ip);
+    return;
+  }
+  if (Get32(p + 12) == 1) {
+    // Someone is searching: answer right away if we are hosting.
+    std::vector<uint8_t> pkt;
+    {
+      std::lock_guard<std::mutex> lock(g_mutex);
+      if (g_hosting && !g_started) pkt = BuildAnnouncement();
+    }
+    if (!pkt.empty()) SendTo(pkt, from_ip, port);
+  }
+}
+
+static void LobbyThread() {
+  uint16_t port = static_cast<uint16_t>(REXCVAR_GET(net_lobby_port));
+  uint64_t last_announce = 0, last_hello = 0;
+  std::vector<uint8_t> buf(2048);
+  while (true) {
+    fd_set set;
+    FD_ZERO(&set);
+    FD_SET(g_sock, &set);
+    timeval tv = {0, 200 * 1000};
+    int r = select(int(g_sock) + 1, &set, nullptr, nullptr, &tv);
+    if (r > 0) {
+      sockaddr_in from = {};
+      socklen_type from_len = sizeof(from);
+      int n = recvfrom(g_sock, reinterpret_cast<char*>(buf.data()), int(buf.size()), 0,
+                       reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (n > 0) HandlePacket(buf.data(), size_t(n), ntohl(from.sin_addr.s_addr), port);
+    }
+    uint64_t now = NowMs();
+    if (now - last_announce >= 1000) {
+      last_announce = now;
+      std::vector<uint8_t> pkt;
+      {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_hosting && !g_started) pkt = BuildAnnouncement();
+        for (auto it = g_seen.begin(); it != g_seen.end();) {
+          if (now - it->second.seen_ms > 4000) it = g_seen.erase(it); else ++it;
+        }
+      }
+      if (!pkt.empty()) {
+        for (uint32_t ip : Targets(true)) SendTo(pkt, ip, port);
+      }
+    }
+    if (now - last_hello >= 2000) {
+      last_hello = now;
+      auto hello = BuildQuery(0);
+      for (uint32_t ip : Targets(false)) SendTo(hello, ip, port);
+    }
+  }
+}
+
+static void StartLobby() {
+  std::call_once(g_thread_once, [] {
+    EnsureWinsock();
+    g_sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (g_sock == kBadSock) {
+      REXKRNL_ERROR("netplay: could not open the game-finder socket");
+      return;
+    }
+    int one = 1;
+    setsockopt(g_sock, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&one), sizeof(one));
+    setsockopt(g_sock, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+    sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(static_cast<uint16_t>(REXCVAR_GET(net_lobby_port)));
+    // With a fixed address (VPN or 127.0.0.x), listen only there; otherwise on every network.
+    addr.sin_addr.s_addr = HasFixedIp() ? htonl(LocalIp()) : htonl(INADDR_ANY);
+    if (bind(g_sock, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+      REXKRNL_ERROR("netplay: could not listen on UDP port {} for games",
+                    REXCVAR_GET(net_lobby_port));
+      CloseSock(g_sock);
+      g_sock = kBadSock;
+      return;
+    }
+    REXKRNL_INFO("netplay: looking for games on UDP port {}", REXCVAR_GET(net_lobby_port));
+    std::thread(LobbyThread).detach();
+  });
+}
+
+void SetContext(uint32_t id, uint32_t value) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_contexts[id] = value;
+}
+
+// XSessionCreate as host: makes the session's XSESSION_INFO (60 bytes) and starts announcing it.
+void HostSession(uint8_t* info_out, uint32_t slots_pub, uint32_t slots_priv) {
+  StartLobby();
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_host = Session();
+  RandomBytes(g_host.xnkid, 8);
+  g_host.xnkid[0] = uint8_t(0x80 | (g_host.xnkid[0] & 0x0F));  // online peer session
+  MakeXnAddr(LocalIp(), g_host.xnaddr);
+  RandomBytes(g_host.xnkey, 16);
+  for (auto& c : g_contexts) g_host.contexts.emplace_back(c.first, c.second);
+  g_slots_pub = slots_pub;
+  g_slots_priv = slots_priv;
+  g_hosting = true;
+  g_started = false;
+  if (info_out) {
+    std::memcpy(info_out, g_host.xnkid, 8);
+    std::memcpy(info_out + 8, g_host.xnaddr, 36);
+    std::memcpy(info_out + 44, g_host.xnkey, 16);
+  }
+  REXKRNL_INFO("netplay: hosting a game ({} public, {} private slots, {} settings)", slots_pub,
+               slots_priv, g_host.contexts.size());
+}
+
+void JoinedSession(const uint8_t* info) {
+  if (!info) return;
+  REXKRNL_INFO("netplay: joining the game hosted at {}", IpToString(XnAddrIp(info + 8)));
+}
+
+void DeleteSession() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_hosting) REXKRNL_INFO("netplay: stopped hosting");
+  g_hosting = false;
+}
+
+void SessionJoined(bool remote, uint32_t count, bool private_slots) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (!g_hosting) return;
+  if (private_slots) g_host.filled_priv += count; else g_host.filled_pub += count;
+  if (remote) REXKRNL_INFO("netplay: {} player(s) joined your game", count);
+}
+
+void SessionStarted(bool started) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_started = started;
+}
+
+static std::vector<Session> MatchingSessions(
+    const std::vector<std::pair<uint32_t, uint32_t>>& wanted) {
+  std::vector<Session> out;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  for (auto& kv : g_seen) {
+    const Session& s = kv.second;
+    if (!s.open_pub && !s.open_priv) continue;
+    bool ok = true;
+    for (auto& w : wanted) {
+      for (auto& c : s.contexts) {
+        if (c.first == w.first && c.second != w.second) ok = false;
+      }
+    }
+    if (ok) out.push_back(s);
+  }
+  return out;
+}
+
+// Sessions announced by other PCs in the last few seconds that match the searched settings.
+// If none are known yet, ask the network "is anyone hosting?" and wait briefly for answers.
+std::vector<Session> FindSessions(const std::vector<std::pair<uint32_t, uint32_t>>& wanted) {
+  StartLobby();
+  auto out = MatchingSessions(wanted);
+  if (!out.empty() || g_sock == kBadSock) return out;
+  uint16_t port = static_cast<uint16_t>(REXCVAR_GET(net_lobby_port));
+  auto query = BuildQuery(1);
+  for (int round = 0; round < 3 && out.empty(); ++round) {
+    for (uint32_t ip : Targets(true)) SendTo(query, ip, port);
+    for (int i = 0; i < 5 && out.empty(); ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      out = MatchingSessions(wanted);
+    }
+  }
+  return out;
+}
+
+void SetQosData(const uint8_t* kid, const uint8_t* data, uint32_t len) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_qos_data[KidKey(kid)].assign(data, data + len);
+}
+
+std::vector<uint8_t> GetQosData(const uint8_t* kid) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto it = g_seen.find(KidKey(kid));
+  if (it != g_seen.end()) return it->second.qos;
+  return {};
+}
